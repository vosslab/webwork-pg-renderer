<header id="iframe-header" class="preview-pane-header">
  <div>
    <h2 id="preview-pane-title">Rendered problem</h2>
    <p id="render-status" class="app-status render-status" role="status" aria-live="polite">Load or edit a problem, then render it.</p>
  </div>
  <div class="preview-controls">
    <button type="button" id="render-button">Render problem</button>
    <label><input type="checkbox" class="checkbox-input" id="show-hint" name="isInstructor" value="1"> Instructor</label>
    <label><input type="checkbox" class="checkbox-input" id="showHints" name="showHints" value="1"> Show hints</label>
    <label><input type="checkbox" class="checkbox-input" id="show-solution" name="clientDebug" value="1"> Debug</label>
  </div>
</header>
<div id="render-contents" class="preview-content">
  <iframe class="iframe-responsive" id="rendered-problem" title="Rendered WeBWorK problem"></iframe>
</div>
