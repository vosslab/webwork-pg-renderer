<header class="editor-pane-header">
  <div>
    <h2 id="editor-pane-title">Problem source</h2>
    <p id="currentEditPath" class="editor-path" aria-live="polite">Unsaved editor contents</p>
  </div>
  <div class="editor-actions" aria-label="Problem file controls">
    <div class="editor-field editor-file-field">
      <label for="sourceFilePath">File path</label>
      <input type="text" id="sourceFilePath" name="sourceFilePath" autocomplete="off" placeholder="private/sample.pg">
    </div>
    <div class="editor-field">
      <button type="button" id="load-problem">Load</button>
      <button type="button" id="save-problem">Save</button>
    </div>
    <div class="editor-field">
      <label for="problemSeed">Seed</label>
      <input type="number" id="problemSeed" name="problemSeed" inputmode="numeric" min="1" max="999999" autocomplete="off">
      <button type="button" id="randomize-seed">New seed</button>
    </div>
    <div class="editor-field">
      <label for="template-select">Template</label>
      <select id="template-select" name="outputFormat">
        <option value="default" selected>Default</option>
        <option value="static">Static</option>
        <option value="debug">Debug</option>
      </select>
    </div>
  </div>
</header>
<div id="problem-editor" class="editor-content">
  <div id="problemContentsEditor" class="code-mirror-editor"></div>
</div>
