<div class="editor-actions" role="group" aria-label="Problem controls">
  <div class="editor-file-controls">
    <div class="editor-field">
      <label for="sourceFilePath">File path</label>
      <input type="text" class="app-field" id="sourceFilePath" name="sourceFilePath" autocomplete="off" placeholder="private/sample.pg">
    </div>
    <div class="editor-file-buttons">
      <button type="button" class="app-button app-button--secondary" id="load-problem">Load</button>
      <button type="button" class="app-button app-button--secondary" id="save-problem">Save</button>
    </div>
  </div>
  <div class="editor-settings" role="group" aria-label="Render settings">
    <div class="editor-field">
      <label for="problemSeed">Seed</label>
      <input type="number" class="app-field" id="problemSeed" name="problemSeed" inputmode="numeric" min="1" max="999999" autocomplete="off">
      <button type="button" class="app-button app-button--secondary" id="randomize-seed"
        aria-label="New seed" title="New seed"><span aria-hidden="true">&#x1F3B2;</span></button>
    </div>
    <div class="editor-field">
      <label for="template-select">Template</label>
      <div class="editor-select">
        <select class="app-field" id="template-select" name="outputFormat">
          <option value="default" selected>Default</option>
          <option value="static">Static</option>
          <option value="debug">Debug</option>
        </select>
      </div>
    </div>
  </div>
</div>
