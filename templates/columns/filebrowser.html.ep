<link rel="stylesheet" href="css/filebrowser.css">
<form action="render-api/cat" method="post" id="BackNavigation" class="browser-form">
  %= hidden_field maxDepth => 1
  <label for="back-nav">Current directory</label>
  %= select_field basePath => ['/'], id => 'back-nav', class => 'back-nav'
</form>
<form action="render-api/cat" method="post" id="FileBrowserForm" class="browser-form browser-files">
  %= hidden_field maxDepth => 1
  <label for="file-list">Folders and problems</label>
  %= select_field basePath => [@{stash('opl_folders') // []}, [private => 'private/']], id => 'file-list', class => 'file-list', size => 12
  <button type="submit" id="open-browser-item" class="app-button">Open selected item</button>
  <p class="browser-help">Double-click an item to open it.</p>
</form>
<script src="js/filebrowser.js"></script>
