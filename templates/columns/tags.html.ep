<link rel="stylesheet" href="css/tags.css">

% my $taxo = '[]';
% my $taxo_path = $c->app->home->child('tmp/tagging-taxonomy.json');
% if ( open(TAXONOMY, "<:encoding(utf8)", $taxo_path) ) {
%     $taxo = join("", <TAXONOMY>);
%     close TAXONOMY;
% } else {
%     $c->app->log->warn("Missing taxonomy file: $taxo_path");
% }

    %= form_for 'render-api/tags' => ( method => 'POST', id => 'problem-tags' ) => begin
    %= hidden_field 'file' => '', id => 'tag-filename'
    <fieldset id='tag-wrapper' class='wrapper tag-group'>
        <legend>Library information</legend>
        <div class='form-row'>
            %= label_for 'Status' => 'Review Status: '
            %= select_field 'Status' => [['not reviewed' => ''], ['Accepted' => 'A'], ['Missing resource' => 'N'], ['Hold for further review' => 'F'], ['Rejected' => 'R']]
        </div>
        <div class='form-row'>
            %= label_for 'Description' => 'Description: '
            %= text_area 'Description'
        </div>
        <div class='form-row'>
            %= label_for 'Author' => 'Author: '
            %= text_field 'Author'
        </div>
        <div class='form-row'>
            %= label_for 'Institution' => 'Institution: '
            %= text_field 'Institution'
        </div>
        <div class='form-row'>
            %= label_for 'Date' => 'Date: '
            %= text_field 'Date'
        </div>
        <div class='form-row'>
            %= label_for 'DBsubject' => 'DBsubject: '
            %= select_field 'DBsubject' => [''], id => 'db-subject'
        </div>
        <div class='form-row'>
            %= label_for 'DBchapter' => 'DBchapter: '
            %= select_field 'DBchapter' => [''], id => 'db-chapter'
        </div>
        <div class='form-row'>
            %= label_for 'DBsection' => 'DBsection: '
            %= select_field 'DBsection' => [''], id => 'db-section'
        </div>
        <div class='form-row'>
            %= label_for 'Level' => 'Level: '
            %= select_field 'Level' => [1,2,3,4,5,6]

        </div>
        <div class='form-row'>
            %= label_for 'Language' => 'Language: '
            %= text_field 'Language'
        </div>
        <div class='form-row'>
            %= label_for 'Keywords' => 'Keywords: '
            %= text_field 'Keywords'
        </div>
        <div class='form-row'>
            %= label_for 'Resources' => 'Resources: '
            %= text_field 'Resources'
        </div>
        <div class='form-row'>
            %= label_for 'MO' => 'MathObjects: '
            %= check_box 'MO', id => 'MO', value => 1
        </div>
        <div class='form-row'>
            %= label_for 'Static' => 'Static: '
            %= check_box 'Static', id => 'Static', value => 1
        </div>
    </fieldset>
    <fieldset id='flags-wrapper' class='wrapper tag-group'>
        <legend>Available content</legend>
        <div class='form-row'>
            %= label_for 'hintExists' => 'Hint provided: '
            %= check_box 'hintExists', id => 'hintExists', value => 1
        </div>
        <div class='form-row'>
            %= label_for 'solutionExists' => 'Solution provided: '
            %= check_box 'solutionExists', id => 'solutionExists', value => 1
        </div>
    </fieldset>
    <div class = 'form-row'>
        <button type="submit" id="save-tags" class="app-button" disabled>Save tags</button>
    </div>
    <p id="tag-status" class="app-status" role="status" aria-live="polite"></p>
    %= end

%= javascript begin
const taxo = <%== $taxo %>;
%= end
<script src="js/tags.js"></script>
