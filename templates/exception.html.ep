<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Renderer error</title>
    %= stylesheet "$ENV{baseURL}/css/fonts.css"
    %= stylesheet "$ENV{baseURL}/css/navbar.css"
  </head>
  % my $message = $c->stash('message') // $c->stash('exception')->message;
  % my $render_root = $ENV{RENDER_ROOT} // '';
  % $message =~ s!\Q$render_root\E/!!g if length $render_root;
  <body>
    <main class="app-error" aria-labelledby="error-title">
      <p class="app-error-code">Renderer error</p>
      <h1 id="error-title">The request could not be completed</h1>
      <pre class="app-error-message"><%= $message %></pre>
    </main>
  </body>
</html>
