<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <base href="<%= $main::basehref %>">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= $c->stash('page_title') // 'WeBWorK Standalone Renderer' %></title>
    <link rel="stylesheet" href="css/fonts.css">
    <link rel="stylesheet" href="css/navbar.css">
  </head>
  <body>
    % my $current_page = $c->stash('renderer_page') // '';
    <header class="app-header">
      <a class="app-brand" href="./">WeBWorK renderer</a>
      <nav class="app-nav" aria-label="Renderer sections">
        <a id="editor-nav" href="./" aria-current="<%= $current_page eq 'editor' ? 'page' : 'false' %>">Editor</a>
        <a id="library-nav" href="opl" aria-current="<%= $current_page eq 'library' ? 'page' : 'false' %>">Problem library</a>
      </nav>
    </header>
    <main class="app-main">
      <%= content %>
    </main>
    % if ($current_page eq 'editor') {
      <script src="js/navbar.js"></script>
    % }
  </body>
</html>
