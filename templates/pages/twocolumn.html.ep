% stash renderer_page => 'editor';
% layout 'navbar';
<link rel="stylesheet" href="css/twocolumn.css">
<script src="node_modules/@openwebwork/pg-codemirror-editor/dist/pg-codemirror-editor.js"></script>

<section class="editor-workspace" aria-labelledby="editor-workspace-title">
  <h1 id="editor-workspace-title">Problem editor</h1>
  <section id="editor-panel" class="app-panel editor-pane" aria-labelledby="editor-pane-title">
    %= include 'columns/editorUI'
  </section>
  <section id="preview-panel" class="app-panel preview-pane" aria-labelledby="preview-pane-title">
    %= include 'columns/editorIframe'
  </section>
</section>
